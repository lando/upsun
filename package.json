{
  "name": "@lando/upsun",
  "description": "Lando plugin for Upsun Fixed (ex-Platform.sh). Phase-1: Fixed config + platform CLI / PLATFORMSH_CLI_TOKEN. Flex is not supported.",
  "version": "1.0.0-alpha.0",
  "author": "Mike Pirog @pirog",
  "license": "MIT",
  "repository": "lando/upsun",
  "bugs": "https://github.com/lando/upsun/issues/new",
  "homepage": "https://github.com/lando/upsun",
  "keywords": [
    "lando",
    "lando-plugin",
    "lando-recipe",
    "lando-hosting-integration",
    "upsun",
    "platformsh"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "lando": {},
  "main": "index.js",
  "nyc": {
    "include": [
      "lib/**/*.js",
      "recipes/**/*.js",
      "services/**/*.js",
      "types/**/*.js"
    ],
    "exclude": [
      "test/**"
    ],
    "cache": true,
    "all": true
  },
  "scripts": {
    "coverage": "nyc report --reporter=text-lcov | coveralls",
    "docs:build": "LANDO_MVB_VERSION=$(git describe --tags --always --abbrev=1 --match=\"v[0-9].*\") vitepress build docs",
    "docs:dev": "LANDO_MVB_VERSION=$(git describe --tags --always --abbrev=1 --match=\"v[0-9].*\") vitepress dev docs",
    "docs:mvb": "npx mvb docs",
    "docs:preview": "vitepress preview docs",
    "lint": "eslint . --config eslint.config.js",
    "test:unit": "nyc --reporter=html --reporter=text mocha --timeout 5000 test/**/*.spec.js",
    "test:leia": "leia \"examples/**/README.md\" -c 'Destroy tests' --stdin",
    "test": "npm run lint && npm run test:unit"
  },
  "dependencies": {
    "js-yaml": "^3.4.6",
    "lodash": "^4.17.21",
    "platformsh-client": "0.1.230",
    "tar": "^6.1.11"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.25.7",
    "@lando/core": "^3",
    "@lando/leia": "^0.6.4",
    "@lando/vitepress-theme-default-plus": "^1.2.0",
    "chai": "^4.3.4",
    "command-line-test": "^1.0.10",
    "eslint": "^9.12.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-jsdoc": "^50.3.1",
    "globals": "^17.12.0",
    "mocha": "^9.1.2",
    "nyc": "^15.1.0",
    "vitepress": "^1.5.0",
    "yaml": "^2.6.0"
  },
  "bundleDependencies": [
    "js-yaml",
    "lodash",
    "platformsh-client",
    "tar"
  ]
}
