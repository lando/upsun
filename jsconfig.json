{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "target": "es2022",
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": [
    "app.js",
    "index.js",
    "builders/**/*.js",
    "inits/**/*.js",
    "lib/**/*.js",
    "dev/**/*.js"
  ],
  "exclude": ["node_modules"]
}
